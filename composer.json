{
    "name": "jackkowalik/plaid-transaction-monitor",
    "description": "Bank account monitoring on Plaid, with a rules engine and alert delivery.",
    "type": "project",
    "license": "MIT",
    "keywords": ["plaid", "transactions", "monitoring", "fraud", "alerts"],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "firebase/php-jwt": "^7.0",
        "phpmailer/phpmailer": "^6.9",
        "psr/clock": "^1.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "suggest": {
        "ext-pdo_mysql": "Required for the MySQL storage backend",
        "ext-pdo_sqlite": "Required for the SQLite storage backend",
        "ext-sodium": "Required to encrypt stored access tokens with ACCESS_TOKEN_KEY"
    },
    "autoload": {
        "psr-4": {
            "PlaidMonitor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PlaidMonitor\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test-sandbox": "phpunit --testsuite sandbox"
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "phpunit/phpunit": "^10.5"
    }
}

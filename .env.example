# Plaid credentials from dashboard.plaid.com -> Developers -> Keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox or production
PLAID_ENV=sandbox

# Public URL of public/webhook.php. Passed to Plaid when creating link
# tokens and sandbox items.
PLAID_WEBHOOK_URL=

# Verify the Plaid-Verification JWT on incoming webhooks. Only turn this off
# for local testing with hand-written payloads; it cannot be turned off with
# PLAID_ENV=production.
PLAID_VERIFY_WEBHOOKS=true

# MySQL: mysql:host=127.0.0.1;dbname=monitor;charset=utf8mb4
# SQLite: sqlite:./monitor.db (relative to the project root)
DB_DSN=sqlite:./monitor.db
DB_USER=
DB_PASS=

# Encrypts Plaid access tokens in the items table. 32 random bytes, base64:
#   php -r 'echo base64_encode(random_bytes(32)), PHP_EOL;'
# Tokens saved before the key was set keep working and are encrypted the
# next time the item is saved. Losing the key means relinking every item.
ACCESS_TOKEN_KEY=

# Paid /transactions/refresh for intervals below the cutoff. Off by default;
# with it off every integration waits for Plaid's automatic updates.
MONITOR_PAID_REFRESH_ENABLED=false
MONITOR_PAID_REFRESH_CUTOFF_MINUTES=1440

# Fraction of the interval that must pass since processing last started.
# SHORT applies to the scheduler, AUTO to Plaid's automatic updates.
MONITOR_SHORT_THRESHOLD=0.9
MONITOR_AUTO_THRESHOLD=0.85

# How long a worker holds an item lock before another worker may take it.
# Must be longer than the slowest sync, rules and alert delivery for one item.
MONITOR_LOCK_TTL_SECONDS=300

# Attempts per queued webhook before it is marked failed
MONITOR_JOB_MAX_ATTEMPTS=5

# Only needed for the geolocation rule on transactions without coordinates
GOOGLE_GEOCODING_API_KEY=

# Only needed for email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# tls, ssl or none
SMTP_ENCRYPTION=tls
ALERT_FROM_ADDRESS=
ALERT_FROM_NAME=Transaction Monitor

# debug, info, warning or error
LOG_LEVEL=info
